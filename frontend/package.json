{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/validate-resources.ts && tsc -b && vite build",
    "lint": "eslint .",
    "test": "node --require ./scripts/node-userinfo-shim.cjs --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "test:e2e": "playwright test",
    "check:resource-links": "node --import tsx scripts/check-resource-links.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "8.4.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.54.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "axe-core": "^4.10.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tsx": "^4.22.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
